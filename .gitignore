*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
doc/api/

# Android
android/gradle/
android/gradlew
android/gradlew.bat
android/local.properties
android/.gradle
android/captures/
android/gradlew
android/gradlew.bat
android/libs/
android/app/libs/
android/app/build/
android/app/src/main/assets/
# Keystore files (NE JAMAIS COMMITTER VOS CLÉS DE SIGNATURE)
*.jks
*.keystore
key.properties

# iOS
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Generated.xcconfig
# Clé du SDK Google Maps iOS (règle n°10). Le modèle commité est
# `Secrets.example.xcconfig`.
ios/Flutter/Secrets.xcconfig
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*
ios/.generated/
ios/Pods/
ios/Podfile.lock
ios/DerivedData/

# Windows
windows/flutter/ephemeral/

# Linux
linux/flutter/ephemeral/

# MacOS
macos/flutter/ephemeral/

# Web
web/icons/ # Seulement si générés automatiquement, sinon gardez-les


android/app/google-services.json
ios/Runner/GoogleService-Info.plist
firebase_options.dart

# Environnement
.env
.env.*

lib/generated_plugin_registrant.dart

# Notes de travail locales, non versionnées : le dossier reste ignoré par
# défaut, seules les références partagées avec l'équipe sont ré-incluses
# nommément ci-dessous. `/docs/*` (et non `/docs`) est indispensable : git
# refuse de ré-inclure un fichier dont le dossier parent est lui-même exclu.
/docs/*
!/docs/backend-contract.md
!/docs/design-api-map.md
!/docs/mode-simule.md
!/docs/backend-a-implementer.md

# Dumps mémoire et journaux de plantage de la JVM (Gradle)
*.hprof
hs_err_pid*.log
