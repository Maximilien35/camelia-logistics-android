// Modèle du fichier de clés iOS — à recopier en `Secrets.xcconfig`, qui est
// ignoré par git et n'est **jamais** commité (règle n°10).
//
//   cp ios/Flutter/Secrets.example.xcconfig ios/Flutter/Secrets.xcconfig
//
// Puis remplacer la valeur ci-dessous par la clé iOS créée dans la console
// Google Cloud, restreinte aux applications iOS et à l'identifiant de bundle
// `com.camelia.logistics`, limitée à la seule API « Maps SDK for iOS ».
//
// Sans ce fichier le build passe et la carte de l'écran A4 reste grise : un
// build de développement qui ne touche pas à cet écran n'est pas bloqué.
GOOGLE_MAPS_API_KEY=METTRE_ICI_LA_CLE_IOS
