<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- production requis pour les builds distribués via TestFlight/App Store.
	 Pour du debug local en direct depuis Xcode, un profil de développement
	 utilisera automatiquement l'environnement "development" côté APNs
	 indépendamment de cette valeur ; ne repasse pas cette clé en "development"
	 pour un build destiné à Codemagic/App Store. -->
</dict>
</plist>